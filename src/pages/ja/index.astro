---
/**
 * 日本語版トップページ
 */
import DocsLayout from '../../layouts/DocsLayout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getCollection } from 'astro:content';

// VFMでコンバートされたドキュメントを取得
let indexDoc = null;
let htmlContent = '';

try {
  const docs = await getCollection('docs-ja');
  indexDoc = docs.find(doc => doc.id === 'ja/index' || doc.id.endsWith('/index') || doc.id === 'index');
  if (indexDoc?.rendered) {
    htmlContent = indexDoc.rendered.html;
  }
} catch (error) {
  console.error('Failed to load docs:', error);
}

const title = indexDoc?.data?.title || 'Vivliostyle ドキュメントへようこそ';
const description = indexDoc?.data?.description || 'Vivliostyle公式ドキュメント';
---

<DocsLayout
  title={title}
  description={description}
  lang="ja"
  availableLanguages={['en', 'ja']}
>
  <LanguageSwitcher slot="header" currentLang="ja" pagePath="/" hasTranslation={true} />
  <nav slot="sidebar" class="home-sidebar">
    <h3>ドキュメント</h3>
    <ul class="sidebar-top">
      <li class="active"><a href="/ja/" aria-current="page">ホーム</a></li>
    </ul>

    <div class="sidebar-accordion">
      <div class="accordion-section">
        <button class="accordion-toggle" aria-controls="new-features-group" aria-expanded="true">
          <span class="toggle-icon" aria-hidden="true">▶</span>新機能ガイド
        </button>
        <ul class="accordion-content" id="new-features-group">
          <li><a href="/ja/new-features/">概要</a></li>
          <li><a href="/ja/new-features/footnotes/">脚注ガイド</a></li>
          <li><a href="/ja/new-features/cmyk/">CMYK 変換ガイド</a></li>
          <li><a href="/ja/new-features/page-groups/">ページグループガイド</a></li>
        </ul>
      </div>

      <div class="accordion-section">
        <button class="accordion-toggle" aria-controls="product-group" aria-expanded="true">
          <span class="toggle-icon" aria-hidden="true">▶</span>プロダクト
        </button>
        <ul class="accordion-content" id="product-group">
          <li><a href="/ja/viewer/">Vivliostyle Viewer</a></li>
          <li><a href="/ja/cli/">Vivliostyle CLI</a></li>
          <li><a href="/ja/vfm/">VFM</a></li>
          <li><a href="/ja/themes/">Vivliostyle Themes</a></li>
        </ul>
      </div>
    </div>

    <ul class="sidebar-flat">
      <li>
        <a href="https://vivliostyle.org/ja/tutorials/" target="_blank" rel="noopener noreferrer">チュートリアル</a>
      </li>
    </ul>

    <div class="sidebar-accordion">
      <div class="accordion-section">
        <button class="accordion-toggle" aria-controls="reference-group" aria-expanded="true">
          <span class="toggle-icon" aria-hidden="true">▶</span>リファレンス
        </button>
        <div class="accordion-content accordion-content-grouped" id="reference-group">
          <h4 class="subgroup-title">ドキュメント</h4>
          <ul>
            <li><a href="/ja/reference/awesome-vivliostyle/">Awesome Vivliostyle</a></li>
            <li><a href="/ja/reference/supported-css-features/">サポートする CSS 機能</a></li>
            <li><a href="/ja/reference/api/">Core API リファレンス</a></li>
          </ul>
          <h4 class="subgroup-title">コントリビューションガイド</h4>
          <ul>
            <li><a href="/ja/reference/contribution-guide/">Vivliostyle.js</a></li>
            <li><a href="/ja/reference/contributing-cli/">Vivliostyle CLI</a></li>
            <li><a href="/ja/reference/contributing-vfm/">VFM</a></li>
            <li><a href="/ja/reference/contributing-themes/">Vivliostyle Themes</a></li>
          </ul>
        </div>
      </div>
    </div>

    <ul class="sidebar-flat">
      <li>
        <a href="https://vivliostyle.org/ja/faq/" target="_blank" rel="noopener noreferrer">FAQ</a>
      </li>
    </ul>
  </nav>

  {htmlContent ? (
    <Fragment set:html={htmlContent} />
  ) : (
    <article>
      <h1>Vivliostyle ドキュメントへようこそ</h1>
      <p>ドキュメントを読み込み中...</p>
      <p>このメッセージが表示される場合、VFMローダーがまだコンテンツを処理していない可能性があります。</p>
    </article>
  )}
</DocsLayout>

<style>
  .home-sidebar h3 {
    color: var(--color-text);
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }

  .home-sidebar ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .home-sidebar li {
    margin: 0.25rem 0;
  }

  .home-sidebar a {
    color: var(--color-text);
    text-decoration: none;
  }

  .home-sidebar a:hover {
    color: var(--color-primary);
  }

  .sidebar-top {
    margin-bottom: 0.75rem;
  }

  .sidebar-top li.active a {
    font-weight: bold;
    color: var(--color-primary);
  }

  .sidebar-flat {
    margin: 0.25rem 0 0.5rem;
  }

  .sidebar-accordion {
    margin: 0 0 0.25rem;
  }

  .accordion-section {
    margin-bottom: 0.25rem;
  }

  .accordion-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 0.25rem 0;
    text-align: left;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .accordion-toggle:hover {
    color: var(--color-primary);
  }

  .toggle-icon {
    display: inline-block;
    transition: transform 0.2s;
    margin-right: 0.5rem;
    font-size: 0.7rem;
  }

  .accordion-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(90deg);
  }

  /* L3 項目を含むコンテナ。1.75rem の padding-left により L3 を全アコーディオンで揃える */
  .accordion-content {
    padding-left: 1.75rem;
    margin: 0.25rem 0 0;
  }

  .accordion-content-grouped > ul {
    margin-bottom: 0.25rem;
  }

  /* L3: 各ナビ項目（アコーディオン配下）。L1 のトグル / トップレベルリンクより一段小さく */
  .accordion-content a {
    font-size: 0.85rem;
    font-weight: 400;
  }

  /* L2: サブグループ見出し。
     - L1 と同じウエイト・muted カラーで「ラベル」として機能
     - margin-left: -1rem で accordion-content の padding-left（1.75rem）を 1rem 戻し、
       L2（0.75rem）と L3（1.75rem）の差をちょうど 1em（1 文字分）にする */
  .subgroup-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin: 0.4rem 0 0.15rem -1rem;
    letter-spacing: 0;
  }

  /* 外部リンクには「↗」を末尾に付与し、新しいタブで開くことを示す */
  .home-sidebar a[target="_blank"]::after {
    content: " ↗";
    font-size: 0.85em;
    opacity: 0.7;
    margin-left: 0.15em;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.home-sidebar .accordion-toggle');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = button.getAttribute('aria-controls');
        const content = targetId ? document.getElementById(targetId) : null;
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        if (content) {
          if (isExpanded) {
            content.setAttribute('hidden', '');
          } else {
            content.removeAttribute('hidden');
          }
        }
      });
    });
  });
</script>
