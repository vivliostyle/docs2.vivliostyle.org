---
/**
 * 日本語版トップページ
 */
import DocsLayout from '../../layouts/DocsLayout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getCollection } from 'astro:content';

// VFMでコンバートされたドキュメントを取得
let indexDoc = null;
let htmlContent = '';

try {
  const docs = await getCollection('docs-ja');
  indexDoc = docs.find(doc => doc.id === 'ja/index' || doc.id.endsWith('/index') || doc.id === 'index');
  
  if (indexDoc && indexDoc.rendered) {
    htmlContent = indexDoc.rendered.html;
  }
} catch (error) {
  console.error('Failed to load docs:', error);
}

const title = indexDoc?.data?.title || 'Vivliostyle ドキュメントへようこそ';
const description = indexDoc?.data?.description || 'Vivliostyle公式ドキュメント';
---

<DocsLayout
  title={title}
  description={description}
  lang="ja"
  availableLanguages={['en', 'ja']}
>
  <LanguageSwitcher slot="header" currentLang="ja" pagePath="/" hasTranslation={true} />
  <nav slot="sidebar">
    <h3>ドキュメント</h3>
    <ul class="top-links" style="list-style: none; padding-left: 0; margin-bottom: 0.5rem;">
      <li><a href="/ja/">ホーム</a></li>
      <li><a href="/ja/new-features/">新機能ガイド</a></li>
    </ul>
    <div class="sidebar-accordion">
      <div class="accordion-section">
        <div class="accordion-header">
          <button class="accordion-toggle" data-target="products-group" aria-expanded="true" aria-controls="products-group" aria-label="プロダクトの開閉">
            <span class="toggle-icon" aria-hidden="true"></span>
          </button>
          <span class="accordion-section-title">プロダクト</span>
        </div>
        <ul class="accordion-content" id="products-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
          <li><a href="/ja/viewer/">Vivliostyle Viewer</a></li>
          <li><a href="/ja/cli/">Vivliostyle CLI</a></li>
          <li><a href="/ja/vfm/">VFM</a></li>
          <li><a href="/ja/themes/">Vivliostyle Themes</a></li>
        </ul>
      </div>
    </div>
    <ul class="top-links" style="list-style: none; padding-left: 0; margin: 0.5rem 0;">
      <li><a href="https://vivliostyle.org/ja/tutorials/" target="_blank" rel="noopener noreferrer">チュートリアル</a></li>
    </ul>
    <div class="sidebar-accordion">
      <div class="accordion-section">
        <div class="accordion-header">
          <button class="accordion-toggle" data-target="reference-group" aria-expanded="true" aria-controls="reference-group" aria-label="リファレンスの開閉">
            <span class="toggle-icon" aria-hidden="true"></span>
          </button>
          <a href="/ja/reference/" class="accordion-section-title">リファレンス</a>
        </div>
        <ul class="accordion-content" id="reference-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
          <li><a href="/ja/reference/supported-css-features/">サポートする CSS 機能</a></li>
          <li><a href="/ja/reference/api/">Core API リファレンス</a></li>
          <li><a href="/ja/reference/awesome-vivliostyle/">Awesome Vivliostyle</a></li>
          <li><a href="/ja/reference/contribution-guide/">コントリビューションガイド</a></li>
        </ul>
      </div>
    </div>
    <ul class="top-links" style="list-style: none; padding-left: 0; margin: 0.5rem 0;">
      <li><a href="https://vivliostyle.org/ja/faq/" target="_blank" rel="noopener noreferrer">FAQ</a></li>
    </ul>
  </nav>

  {htmlContent ? (
    <Fragment set:html={htmlContent} />
  ) : (
    <article>
      <h1>Vivliostyle ドキュメントへようこそ</h1>
      <p>ドキュメントを読み込み中...</p>
      <p>このメッセージが表示される場合、VFMローダーがまだコンテンツを処理していない可能性があります。</p>
    </article>
  )}
</DocsLayout>

<style>
  nav h3 {
    color: var(--color-text);
  }

  nav ul li a {
    color: var(--color-text);
    text-decoration: none;
  }

  nav ul li a:hover {
    color: var(--color-primary);
  }

  .sidebar-accordion {
    margin-top: 0.5rem;
  }

  .accordion-section {
    margin-bottom: 0.5rem;
  }

  .accordion-toggle {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
  }

  .accordion-toggle:hover {
    color: var(--color-primary);
  }

  .toggle-icon {
    display: inline-block;
    width: 1em;
    font-size: 0.7rem;
  }

  /* 展開状態は ▼、折りたたみ状態は ▶ を ::before で描画。
   * SVG/フォント依存の rotate 表現だと環境差で「▼」に見えないことがあるので
   * 文字そのものを切り替える。 */
  .accordion-toggle .toggle-icon::before {
    content: '▶';
  }
  .accordion-toggle[aria-expanded="true"] .toggle-icon::before {
    content: '▼';
  }

  .accordion-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .accordion-section-title {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
  }

  a.accordion-section-title:hover {
    color: var(--color-primary);
  }

  .accordion-content li {
    margin: 0.25rem 0;
  }

  .accordion-content a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
  }

  .accordion-content a:hover {
    color: var(--color-primary);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.accordion-toggle');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-target');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        if (targetId) {
          const content = document.getElementById(targetId);
          if (content) content.style.display = isExpanded ? 'none' : 'block';
        }
      });
    });
  });
</script>
