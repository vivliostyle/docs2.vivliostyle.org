---
/**
 * Vivliostyle リファレンス インデックスページ（日本語版）
 */
import DocsLayout from '../../../layouts/DocsLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import DownloadLinks from '../../../components/DownloadLinks.astro';
import { getCollection } from 'astro:content';

// リファレンスindexドキュメントを取得
const indexDocs = await getCollection('vivliostyle-reference-index-ja');
const indexDoc = indexDocs.find(doc => doc.id === 'index' || doc.id.endsWith('/index'));

// 英語版が存在するか確認
const indexDocsEn = await getCollection('vivliostyle-reference-index-en');
const hasEnTranslation = indexDocsEn.length > 0;

const htmlContent = indexDoc?.rendered?.html || '';
const title = indexDoc?.data?.title || 'リファレンス';
const description = indexDoc?.data?.description || 'Vivliostyle関連ドキュメントのリファレンス集';
---

<DocsLayout
  title={title}
  description={description}
  lang="ja"
  section="reference"
  availableLanguages={hasEnTranslation ? ['en', 'ja'] : []}
>
  <!-- ヘッダーに言語切り替え -->
  {hasEnTranslation && (
    <div slot="header">
      <LanguageSwitcher 
        currentLang="ja" 
        pagePath="/reference/"
        hasTranslation={hasEnTranslation}
      />
    </div>
  )}

  <!-- サイドバー -->
  <nav slot="sidebar">
    <h3>リファレンス</h3>
    <ul style="list-style: none; padding-left: 0; margin-bottom: 1rem;">
      <li><a href="/ja/">← ホームに戻る</a></li>
    </ul>
    <div class="sidebar-accordion">
      <div class="accordion-section">
        <div class="accordion-header">
          <button class="accordion-toggle" data-target="docs-group" aria-expanded="true" aria-controls="docs-group" aria-label="ドキュメントの開閉">
            <span class="toggle-icon" aria-hidden="true"></span>
          </button>
          <span class="accordion-section-title">ドキュメント</span>
        </div>
        <ul class="accordion-content" id="docs-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
          <li><a href="/ja/reference/supported-css-features/">サポートする CSS 機能</a></li>
          <li><a href="/ja/reference/api/">Core API リファレンス</a></li>
          <li><a href="/ja/reference/awesome-vivliostyle/">Awesome Vivliostyle</a></li>
        </ul>
      </div>
      <div class="accordion-section">
        <div class="accordion-header">
          <button class="accordion-toggle" data-target="contrib-group" aria-expanded="true" aria-controls="contrib-group" aria-label="コントリビューションガイドの開閉">
            <span class="toggle-icon" aria-hidden="true"></span>
          </button>
          <a href="/ja/reference/contribution-guide/" class="accordion-section-title">コントリビューションガイド</a>
        </div>
        <ul class="accordion-content" id="contrib-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
          <li><a href="/ja/reference/contribution-guide/js/">Vivliostyle.js</a></li>
          <li><a href="/ja/reference/contribution-guide/cli/">Vivliostyle CLI</a></li>
          <li><a href="/ja/reference/contribution-guide/vfm/">VFM</a></li>
          <li><a href="/ja/reference/contribution-guide/themes/">Vivliostyle Themes</a></li>
        </ul>
      </div>
    </div>
    <DownloadLinks product="reference" lang="ja" />
  </nav>

  <article class="docs-content">
    {htmlContent ? (
      <Fragment set:html={htmlContent} />
    ) : (
      <div>
        <h1>{title}</h1>
        <p>リファレンスドキュメントを読み込み中...</p>
      </div>
    )}
  </article>
</DocsLayout>

<style>
  nav h3 {
    font-size: 1rem;
  }

  .sidebar-accordion {
    margin-top: 0.5rem;
  }

  .accordion-section {
    margin-bottom: 0.5rem;
  }

  .accordion-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0;
  }

  .accordion-toggle {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
  }

  .accordion-toggle:hover {
    color: var(--color-primary);
  }

  .toggle-icon {
    display: inline-block;
    width: 1em;
    font-size: 0.7rem;
  }

  /* 展開状態は ▼、折りたたみ状態は ▶ を ::before で描画 */
  .accordion-toggle .toggle-icon::before {
    content: '▶';
  }
  .accordion-toggle[aria-expanded="true"] .toggle-icon::before {
    content: '▼';
  }

  .accordion-section-title {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
  }

  a.accordion-section-title:hover {
    color: var(--color-primary);
  }

  .accordion-content li {
    margin: 0.25rem 0;
  }

  .accordion-content a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
  }

  .accordion-content a:hover {
    color: var(--color-primary);
  }

  .docs-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .docs-content h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .docs-content h2 {
    font-size: 2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .docs-content h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .docs-content ul {
    list-style: disc;
    padding-left: 2rem;
    margin: 1rem 0;
  }

  .docs-content li {
    margin: 0.5rem 0;
  }

  .docs-content a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .docs-content a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .docs-content {
      padding: 1rem;
    }

    .docs-content h1 {
      font-size: 2rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.accordion-toggle');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-target');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        if (targetId) {
          const content = document.getElementById(targetId);
          if (content) content.style.display = isExpanded ? 'none' : 'block';
        }
      });
    });
  });
</script>

