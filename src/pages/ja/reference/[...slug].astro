---
/**
 * Vivliostyle リファレンスページ（日本語版）
 * 動的ルーティング: /ja/reference/* にマッチ
 */
import DocsLayout from '../../../layouts/DocsLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import PageNavigation from '../../../components/PageNavigation.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import DownloadLinks from '../../../components/DownloadLinks.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // アップストリームの CONTRIBUTING.md は "Contribution Guide" /
  // "Contribution Guidelines" のように汎用的な H1 を持つため、プロダクト間で
  // 区別がつかない。プロダクト名を含む見出しに書き換えて、ページ内見出し・
  // パンくず・サイドバー・PDF 章扉/柱の表記を一致させる。
  const withOverriddenH1 = <T extends { rendered?: { html?: string }; data?: Record<string, unknown> }>(
    doc: T,
    newTitle: string,
  ): T => {
    const html = doc.rendered?.html ?? '';
    const newHtml = html.replace(
      /(<h1\b[^>]*>)[\s\S]*?(<\/h1>)/i,
      (_match, open: string, close: string) => `${open}${newTitle}${close}`,
    );
    const oldHeadings =
      (doc.data?.headings as Array<{ depth: number; slug: string; text: string }> | undefined) ?? [];
    const newHeadings = oldHeadings.map((h, i) =>
      i === 0 && h.depth === 1 ? { ...h, text: newTitle } : h,
    );
    return {
      ...doc,
      data: { ...doc.data, headings: newHeadings },
      rendered: { ...(doc.rendered ?? {}), html: newHtml },
    };
  };

  const referenceDocs = await getCollection('vivliostyle-reference-ja');
  const referenceDocsEn = await getCollection('vivliostyle-reference-en');
  const awesomeDocs = await getCollection('awesome-vivliostyle-ja');
  const awesomeDocsEn = await getCollection('awesome-vivliostyle-en');

  // CLI、Themes、VFMのContributingドキュメントも取得
  const cliContributing = await getCollection('vivliostyle-cli-contributing-en');
  const themesContributing = await getCollection('vivliostyle-themes-contributing-en');
  const vfmContributing = await getCollection('vivliostyle-vfm-contributing-en');

  const awesomeDoc = awesomeDocs[0];
  const awesomeDocEn = awesomeDocsEn[0];
  const awesomeTitle = awesomeDoc?.data?.title || 'Awesome Vivliostyle';
  const awesomeReferenceDoc = awesomeDoc
    ? {
        ...awesomeDoc,
        id: 'awesome-vivliostyle',
        data: {
          ...awesomeDoc.data,
          title: awesomeTitle,
        },
      }
    : null;
  const referenceDocsAll = awesomeReferenceDoc
    ? [...referenceDocs, awesomeReferenceDoc]
    : referenceDocs;

  // 英語版に存在するIDのセットを作成
  const enIds = new Set([
    ...referenceDocsEn.map(d => d.id),
    ...(awesomeDocEn ? ['awesome-vivliostyle'] : []),
  ]);

  const paths = [];

  // 通常のリファレンスドキュメント。
  // Vivliostyle.js docs/contribution-guide.md は contribution-guide/js にネスト
  referenceDocs.forEach(doc => {
    if (doc.id === 'contribution-guide') {
      paths.push({
        params: { slug: 'contribution-guide/js' },
        props: {
          doc: {
            ...doc,
            id: 'contribution-guide/js',
            data: {
              ...doc.data,
              title: 'Vivliostyle.js コントリビューションガイド',
            },
          },
          referenceDocs: referenceDocsAll,
          hasEnTranslation: enIds.has('contribution-guide'),
          isContributing: true,
          isHub: false,
        },
      });
      return;
    }
    paths.push({
      params: { slug: doc.id },
      props: {
        doc,
        referenceDocs: referenceDocsAll,
        hasEnTranslation: enIds.has(doc.id),
        isContributing: false,
        isHub: false,
      },
    });
  });

  if (awesomeReferenceDoc) {
    paths.push({
      params: { slug: 'awesome-vivliostyle' },
      props: {
        doc: awesomeReferenceDoc,
        referenceDocs: referenceDocsAll,
        hasEnTranslation: enIds.has('awesome-vivliostyle'),
        isContributing: false,
        isHub: false,
      },
    });
  }

  // コントリビューションガイドのハブページ（仮想ページ /ja/reference/contribution-guide/）
  const hubHtml = `
    <h1>コントリビューションガイド</h1>
    <p>Vivliostyle の各プロダクトの開発に参加する方法を、プロダクトごとに案内します。</p>
    <ul>
      <li><a href="/ja/reference/contribution-guide/js/"><strong>Vivliostyle.js</strong></a> — 組版エンジン本体</li>
      <li><a href="/ja/reference/contribution-guide/cli/"><strong>Vivliostyle CLI</strong></a> — コマンドラインツール</li>
      <li><a href="/ja/reference/contribution-guide/vfm/"><strong>VFM</strong></a> — Vivliostyle Flavored Markdown</li>
      <li><a href="/ja/reference/contribution-guide/themes/"><strong>Vivliostyle Themes</strong></a> — 公式テーマパッケージ</li>
    </ul>
  `;
  paths.push({
    params: { slug: 'contribution-guide' },
    props: {
      doc: {
        id: 'contribution-guide',
        data: {
          title: 'コントリビューションガイド',
          description: 'Vivliostyle 各プロダクトのコントリビューションガイドの索引',
          headings: [],
        },
        rendered: { html: hubHtml },
      },
      referenceDocs: referenceDocsAll,
      hasEnTranslation: true,
      isContributing: false,
      isHub: true,
    },
  });

  // CLI Contributing → /ja/reference/contribution-guide/cli/
  cliContributing.forEach(doc => {
    const title = 'Vivliostyle CLI コントリビューションガイド';
    const overridden = withOverriddenH1(doc, title);
    paths.push({
      params: { slug: 'contribution-guide/cli' },
      props: {
        doc: {
          ...overridden,
          id: 'contribution-guide/cli',
          data: { ...overridden.data, title },
        },
        referenceDocs: referenceDocsAll,
        hasEnTranslation: true,
        isContributing: true,
        isHub: false,
      },
    });
  });

  // Themes Contributing → /ja/reference/contribution-guide/themes/
  themesContributing.forEach(doc => {
    const title = 'Vivliostyle Themes コントリビューションガイド';
    const overridden = withOverriddenH1(doc, title);
    paths.push({
      params: { slug: 'contribution-guide/themes' },
      props: {
        doc: {
          ...overridden,
          id: 'contribution-guide/themes',
          data: { ...overridden.data, title },
        },
        referenceDocs: referenceDocsAll,
        hasEnTranslation: true,
        isContributing: true,
        isHub: false,
      },
    });
  });

  // VFM Contributing → /ja/reference/contribution-guide/vfm/
  vfmContributing.forEach(doc => {
    const title = 'VFM コントリビューションガイド';
    const overridden = withOverriddenH1(doc, title);
    paths.push({
      params: { slug: 'contribution-guide/vfm' },
      props: {
        doc: {
          ...overridden,
          id: 'contribution-guide/vfm',
          data: { ...overridden.data, title },
        },
        referenceDocs: referenceDocsAll,
        hasEnTranslation: true,
        isContributing: true,
        isHub: false,
      },
    });
  });

  return paths;
}

const { doc, referenceDocs, hasEnTranslation, isHub } = Astro.props;
const htmlContent = doc.rendered?.html || '';
const docData = doc.data as Record<string, unknown>;
const title = (docData?.title as string) || 'Vivliostyle リファレンス';
const description = (docData?.description as string) || '';
const extractedToc = docData?.extractedToc as string | undefined;

// 見出しから目次を生成
const headings = (docData?.headings as Array<{ depth: number; slug: string; text: string }>) || [];

// ページの順序を定義（Murakami 氏フィードバック：CSS 機能を先頭、
// コントリビューションガイドは contribution-guide/* 配下にネスト）
const pageOrder = [
  'supported-css-features',
  'api',
  'awesome-vivliostyle',
  'contribution-guide',          // hub
  'contribution-guide/js',       // Vivliostyle.js
  'contribution-guide/cli',      // CLI
  'contribution-guide/vfm',      // VFM
  'contribution-guide/themes',   // Themes
];

// referenceDocs には元の 'contribution-guide' id（Vivliostyle.js docs）が
// 残っているので、ナビゲーション用に id をリマップする
const remappedReferenceDocs = referenceDocs.map(d => {
  if (d.id === 'contribution-guide') {
    return { ...d, id: 'contribution-guide/js', data: { ...d.data, title: 'Vivliostyle.js コントリビューションガイド' } };
  }
  return d;
});
const allDocs = [
  ...remappedReferenceDocs,  // awesome-vivliostyle, contribution-guide/js を含む
  { id: 'contribution-guide', data: { title: 'コントリビューションガイド' } },
  { id: 'contribution-guide/cli', data: { title: 'Vivliostyle CLI コントリビューションガイド' } },
  { id: 'contribution-guide/vfm', data: { title: 'VFM コントリビューションガイド' } },
  { id: 'contribution-guide/themes', data: { title: 'Vivliostyle Themes コントリビューションガイド' } },
];

const sortedDocs = allDocs.sort((a, b) => {
  const indexA = pageOrder.indexOf(a.id);
  const indexB = pageOrder.indexOf(b.id);
  if (indexA === -1 && indexB === -1) return a.id.localeCompare(b.id);
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});

const currentIndex = sortedDocs.findIndex(d => d.id === doc.id);

let prevPage = null;
for (let i = currentIndex - 1; i >= 0; i--) {
  if (pageOrder.includes(sortedDocs[i].id)) {
    prevPage = sortedDocs[i];
    break;
  }
}

let nextPage = null;
for (let i = currentIndex + 1; i < sortedDocs.length; i++) {
  if (pageOrder.includes(sortedDocs[i].id)) {
    nextPage = sortedDocs[i];
    break;
  }
}

// サイドバーで H2/H3 見出しナビ（accordion ではない）を表示するページ
const headingListPages = new Set([
  'awesome-vivliostyle',
  'supported-css-features',
  'api',
  'contribution-guide/js',
  'contribution-guide/cli',
  'contribution-guide/vfm',
  'contribution-guide/themes',
]);
const showHeadingList = !isHub && headingListPages.has(doc.id);
---

<DocsLayout
  title={title}
  description={description}
  lang="ja"
  section="reference"
  availableLanguages={hasEnTranslation ? ['en', 'ja'] : []}
>
  <!-- ヘッダーに言語切り替え -->
  {hasEnTranslation && (
    <div slot="header">
      <LanguageSwitcher 
        currentLang="ja" 
        pagePath={`/reference/${doc.id}`}
        hasTranslation={hasEnTranslation}
      />
    </div>
  )}

  <!-- サイドバーにナビゲーションと目次を表示 -->
  <nav slot="sidebar" id="sidebar-nav">
    <h3><a href="/ja/reference/" style="color: inherit; text-decoration: none;">リファレンス</a></h3>
    
    <!-- 特定ページでのみ見出しリストを表示 -->
    {showHeadingList ? (
      <>
        <ul style="list-style: none; padding-left: 0; margin-bottom: 1rem;">
          <li><a href="/ja/">← ホームに戻る</a></li>
        </ul>
        <div class="toc-headings">
          <ul style="list-style: none; padding-left: 0;">
            {headings.filter(h => h.depth === 2 || h.depth === 3).map((heading, index) => {
              // H2見出しのみ処理（H3は後で追加）
              if (heading.depth !== 2) return null;
              
              // 次のH2までのH3を収集
              const nextH2Index = headings.slice(index + 1).findIndex(h => h.depth === 2);
              const h3List = headings
                .slice(index + 1, nextH2Index === -1 ? undefined : index + 1 + nextH2Index)
                .filter(h => h.depth === 3);
              
              // HTMLタグを除去してプレーンテキストのみを取得
              const getPlainText = (html: string) => {
                return html
                  .replace(/<[^>]*>/g, '')
                  .replace(/&amp;|&#x26;/g, '&');
              };
              
              return (
                <li class="toc-h2">
                  {h3List.length > 0 ? (
                    <button 
                      class="toc-toggle" 
                      data-target={`toc-group-${index}`}
                      aria-expanded="false"
                    >
                      <span class="toggle-icon">▶</span><a href={`#${heading.slug}`}>{getPlainText(heading.text)}</a>
                    </button>
                  ) : (
                    <a href={`#${heading.slug}`} class="toc-h2-link">{getPlainText(heading.text)}</a>
                  )}
                  {h3List.length > 0 && (
                    <ul id={`toc-group-${index}`} class="toc-h3-list" style="display: none; list-style: none; padding-left: 1.5rem;">
                      {h3List.map(h3 => (
                        <li class="toc-h3">
                          <a href={`#${h3.slug}`}>{getPlainText(h3.text)}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </>
    ) : (
      <>
        <ul style="list-style: none; padding-left: 0; margin-bottom: 1rem;">
          <li><a href="/ja/">← ホームに戻る</a></li>
        </ul>
        <div class="sidebar-accordion">
          <div class="accordion-section">
            <button class="accordion-toggle" data-target="docs-group" aria-expanded="true">
              <span class="toggle-icon">▶</span>ドキュメント
            </button>
            <ul class="accordion-content" id="docs-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
              <li class:list={[{ active: doc.id === 'supported-css-features' }]}>
                <a href="/ja/reference/supported-css-features/" aria-current={doc.id === 'supported-css-features' ? 'page' : undefined}>サポートする CSS 機能</a>
              </li>
              <li class:list={[{ active: doc.id === 'api' }]}>
                <a href="/ja/reference/api/" aria-current={doc.id === 'api' ? 'page' : undefined}>Core API リファレンス</a>
              </li>
              <li class:list={[{ active: doc.id === 'awesome-vivliostyle' }]}>
                <a href="/ja/reference/awesome-vivliostyle/" aria-current={doc.id === 'awesome-vivliostyle' ? 'page' : undefined}>Awesome Vivliostyle</a>
              </li>
            </ul>
          </div>
          <div class="accordion-section">
            <button class="accordion-toggle" data-target="contrib-group" aria-expanded="true">
              <span class="toggle-icon">▶</span><a href="/ja/reference/contribution-guide/" style="color: inherit; text-decoration: none;" aria-current={doc.id === 'contribution-guide' ? 'page' : undefined}>コントリビューションガイド</a>
            </button>
            <ul class="accordion-content" id="contrib-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
              <li class:list={[{ active: doc.id === 'contribution-guide/js' }]}>
                <a href="/ja/reference/contribution-guide/js/" aria-current={doc.id === 'contribution-guide/js' ? 'page' : undefined}>Vivliostyle.js</a>
              </li>
              <li class:list={[{ active: doc.id === 'contribution-guide/cli' }]}>
                <a href="/ja/reference/contribution-guide/cli/" aria-current={doc.id === 'contribution-guide/cli' ? 'page' : undefined}>Vivliostyle CLI</a>
              </li>
              <li class:list={[{ active: doc.id === 'contribution-guide/vfm' }]}>
                <a href="/ja/reference/contribution-guide/vfm/" aria-current={doc.id === 'contribution-guide/vfm' ? 'page' : undefined}>VFM</a>
              </li>
              <li class:list={[{ active: doc.id === 'contribution-guide/themes' }]}>
                <a href="/ja/reference/contribution-guide/themes/" aria-current={doc.id === 'contribution-guide/themes' ? 'page' : undefined}>Vivliostyle Themes</a>
              </li>
            </ul>
          </div>
        </div>
      </>
    )}
    <DownloadLinks product="reference" lang="ja" />
  </nav>

  <!-- メインコンテンツ -->
  <article class="docs-content">
    <!-- 抽出したTOCが存在する場合は表示 -->
    {extractedToc && doc.id !== 'awesome-vivliostyle' && (
      <div class="toc">
        {doc.id === 'awesome-vivliostyle' && (
          <h2 class="toc-title">目次</h2>
        )}
        <div class="toc-body" set:html={extractedToc}></div>
      </div>
    )}
    
    <div set:html={htmlContent}></div>
  </article>

  <!-- ページナビゲーション -->
  <PageNavigation
    prevPage={prevPage}
    nextPage={nextPage}
    basePath="/ja/reference"
    prevLabel="← 前へ"
    nextLabel="次へ →"
  />
</DocsLayout>

<style>
  .docs-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .docs-content h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .toc {
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .toc-title {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .toc :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .toc :global(li) {
    margin: 0.5rem 0;
  }

  .toc :global(a) {
    color: var(--color-primary);
    text-decoration: none;
  }

  .toc :global(a:hover) {
    text-decoration: underline;
  }
  
  /* サイドバー見出しリストのスタイル */
  .toc-headings {
    font-size: 1rem;
  }
  
  .toc-h2 {
    margin: 0.5rem 0;
  }
  
  .toc-h2-link {
    color: var(--color-text);
    text-decoration: none;
    display: block;
    padding: 0.25rem 0;
  }
  
  .toc-h2-link:hover {
    color: var(--color-primary);
  }
  
  .toc-toggle {
    display: flex;
    align-items: flex-start;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    text-align: left;
    cursor: pointer;
    gap: 0;
  }
  
  .toggle-icon {
    display: inline-block;
    transition: transform 0.2s;
    font-size: 0.7rem;
    padding-top: 0.2rem;
  }
  
  .toc-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(90deg);
  }
  
  .toc-toggle a {
    color: var(--color-text);
    text-decoration: none;
  }
  
  .toc-toggle a:hover {
    color: var(--color-primary);
  }
  
  .toc-h3-list {
    margin-top: 0.25rem;
  }
  
  .toc-h3 {
    margin: 0.25rem 0;
  }
  
  .toc-h3 a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 1rem;
  }
  
  .toc-h3 a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .docs-content {
      padding: 1rem;
    }

    .docs-content h1 {
      font-size: 2rem;
    }
  }

  /* アコーディオンメニューのスタイル */
  .sidebar-accordion {
    margin-top: 0.5rem;
  }

  .accordion-section {
    margin-bottom: 0.5rem;
  }

  .accordion-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 0.25rem 0;
    text-align: left;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .accordion-toggle:hover {
    color: var(--color-primary);
  }

  .accordion-toggle .toggle-icon {
    margin-right: 0.5rem;
  }

  .accordion-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(90deg);
  }

  .accordion-content li {
    margin: 0.25rem 0;
  }

  .accordion-content a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
  }

  .accordion-content a:hover {
    color: var(--color-primary);
  }
</style>

<script>
  // アコーディオンメニューの開閉処理
  document.addEventListener('DOMContentLoaded', () => {
    // サイドバーアコーディオンのトグル
    const accordionToggles = document.querySelectorAll('.accordion-toggle');
    accordionToggles.forEach(toggle => {
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = toggle.getAttribute('data-target');
        const content = document.getElementById(targetId!);
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        
        toggle.setAttribute('aria-expanded', String(!isExpanded));
        if (content) {
          content.style.display = isExpanded ? 'none' : 'block';
        }
      });
    });

    // TOCトグル
    const toggleButtons = document.querySelectorAll('.toc-toggle');
    
    toggleButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        // リンクのデフォルト動作は許可
        if ((e.target as HTMLElement).tagName === 'A') {
          return;
        }
        
        e.preventDefault();
        const targetId = button.getAttribute('data-target');
        const targetList = document.getElementById(targetId!);
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        
        if (targetList) {
          button.setAttribute('aria-expanded', String(!isExpanded));
          targetList.style.display = isExpanded ? 'none' : 'block';
        }
      });
    });
  });
</script>
