---
/**
 * Vivliostyle Reference Pages (English)
 * Dynamic routing: matches /en/reference/*
 */
import DocsLayout from '../../../layouts/DocsLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import PageNavigation from '../../../components/PageNavigation.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import DownloadLinks from '../../../components/DownloadLinks.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // Upstream CONTRIBUTING.md files use generic H1s like "Contribution Guide" /
  // "Contribution Guidelines" that are indistinguishable across products. We
  // rewrite the first H1 (and the matching headings entry) to a product-scoped
  // title so the in-page heading, breadcrumb, sidebar, and PDF chapter heading /
  // running header all agree.
  const withOverriddenH1 = <T extends { rendered?: { html?: string }; data?: Record<string, unknown> }>(
    doc: T,
    newTitle: string,
  ): T => {
    const html = doc.rendered?.html ?? '';
    const newHtml = html.replace(
      /(<h1\b[^>]*>)[\s\S]*?(<\/h1>)/i,
      (_match, open: string, close: string) => `${open}${newTitle}${close}`,
    );
    const oldHeadings =
      (doc.data?.headings as Array<{ depth: number; slug: string; text: string }> | undefined) ?? [];
    const newHeadings = oldHeadings.map((h, i) =>
      i === 0 && h.depth === 1 ? { ...h, text: newTitle } : h,
    );
    return {
      ...doc,
      data: { ...doc.data, headings: newHeadings },
      rendered: { ...(doc.rendered ?? {}), html: newHtml },
    };
  };

  const referenceDocs = await getCollection('vivliostyle-reference-en');
  const referenceDocsJa = await getCollection('vivliostyle-reference-ja');
  const awesomeDocs = await getCollection('awesome-vivliostyle-en');
  const awesomeDocsJa = await getCollection('awesome-vivliostyle-ja');

  // CLI、Themes、VFMのContributingドキュメントも取得
  const cliContributing = await getCollection('vivliostyle-cli-contributing-en');
  const themesContributing = await getCollection('vivliostyle-themes-contributing-en');
  const vfmContributing = await getCollection('vivliostyle-vfm-contributing-en');

  const awesomeDoc = awesomeDocs[0];
  const awesomeDocJa = awesomeDocsJa[0];
  const awesomeTitle = awesomeDoc?.data?.title || 'Awesome Vivliostyle';
  const awesomeReferenceDoc = awesomeDoc
    ? {
        ...awesomeDoc,
        id: 'awesome-vivliostyle',
        data: {
          ...awesomeDoc.data,
          title: awesomeTitle,
        },
      }
    : null;
  const referenceDocsAll = awesomeReferenceDoc
    ? [...referenceDocs, awesomeReferenceDoc]
    : referenceDocs;

  // 日本語版に存在するIDのセットを作成
  const jaIds = new Set([
    ...referenceDocsJa.map(d => d.id),
    ...(awesomeDocJa ? ['awesome-vivliostyle'] : []),
  ]);

  const paths = [];

  // Regular reference docs (api, supported-css-features) — slug unchanged.
  // The Vivliostyle.js docs/contribution-guide.md is remapped to /contribution-guide/js/.
  referenceDocs.forEach(doc => {
    if (doc.id === 'contribution-guide') {
      paths.push({
        params: { slug: 'contribution-guide/js' },
        props: {
          doc: {
            ...doc,
            id: 'contribution-guide/js',
            data: {
              ...doc.data,
              title: 'Vivliostyle.js Contribution Guide',
            },
          },
          referenceDocs: referenceDocsAll,
          hasJaTranslation: jaIds.has('contribution-guide'),
          isContributing: true,
          isHub: false,
        },
      });
      return;
    }
    paths.push({
      params: { slug: doc.id },
      props: {
        doc,
        referenceDocs: referenceDocsAll,
        hasJaTranslation: jaIds.has(doc.id),
        isContributing: false,
        isHub: false,
      },
    });
  });

  if (awesomeReferenceDoc) {
    paths.push({
      params: { slug: 'awesome-vivliostyle' },
      props: {
        doc: awesomeReferenceDoc,
        referenceDocs: referenceDocsAll,
        hasJaTranslation: jaIds.has('awesome-vivliostyle'),
        isContributing: false,
        isHub: false,
      },
    });
  }

  // Contribution Guide hub (virtual page at /en/reference/contribution-guide/)
  const hubHtml = `
    <h1 id="contribution-guides">Contribution Guides</h1>
    <p>Learn how to contribute to each Vivliostyle product. Choose the project you'd like to contribute to:</p>
    <ul>
      <li><a href="/en/reference/contribution-guide/js/"><strong>Vivliostyle.js</strong></a> — the rendering engine</li>
      <li><a href="/en/reference/contribution-guide/cli/"><strong>Vivliostyle CLI</strong></a> — the command-line tool</li>
      <li><a href="/en/reference/contribution-guide/vfm/"><strong>VFM</strong></a> — Vivliostyle Flavored Markdown</li>
      <li><a href="/en/reference/contribution-guide/themes/"><strong>Vivliostyle Themes</strong></a> — official themes package</li>
    </ul>
  `;
  paths.push({
    params: { slug: 'contribution-guide' },
    props: {
      doc: {
        id: 'contribution-guide',
        data: {
          title: 'Contribution Guides',
          description: 'Index of contribution guides for each Vivliostyle product',
          headings: [],
        },
        rendered: { html: hubHtml },
      },
      referenceDocs: referenceDocsAll,
      hasJaTranslation: true,
      isContributing: false,
      isHub: true,
    },
  });

  // CLI Contributing → /en/reference/contribution-guide/cli/
  cliContributing.forEach(doc => {
    const title = 'Vivliostyle CLI Contribution Guide';
    const overridden = withOverriddenH1(doc, title);
    paths.push({
      params: { slug: 'contribution-guide/cli' },
      props: {
        doc: {
          ...overridden,
          id: 'contribution-guide/cli',
          data: { ...overridden.data, title },
        },
        referenceDocs: referenceDocsAll,
        hasJaTranslation: true,
        isContributing: true,
        isHub: false,
      },
    });
  });

  // Themes Contributing → /en/reference/contribution-guide/themes/
  themesContributing.forEach(doc => {
    const title = 'Vivliostyle Themes Contribution Guide';
    const overridden = withOverriddenH1(doc, title);
    paths.push({
      params: { slug: 'contribution-guide/themes' },
      props: {
        doc: {
          ...overridden,
          id: 'contribution-guide/themes',
          data: { ...overridden.data, title },
        },
        referenceDocs: referenceDocsAll,
        hasJaTranslation: true,
        isContributing: true,
        isHub: false,
      },
    });
  });

  // VFM Contributing → /en/reference/contribution-guide/vfm/
  vfmContributing.forEach(doc => {
    const title = 'VFM Contribution Guide';
    const overridden = withOverriddenH1(doc, title);
    paths.push({
      params: { slug: 'contribution-guide/vfm' },
      props: {
        doc: {
          ...overridden,
          id: 'contribution-guide/vfm',
          data: { ...overridden.data, title },
        },
        referenceDocs: referenceDocsAll,
        hasJaTranslation: true,
        isContributing: true,
        isHub: false,
      },
    });
  });

  return paths;
}

const { doc, referenceDocs, hasJaTranslation, isHub } = Astro.props;
const htmlContent = doc.rendered?.html || '';
const docData = doc.data as Record<string, unknown>;
const title = (docData?.title as string) || 'Vivliostyle Reference';
const description = (docData?.description as string) || '';
const extractedToc = docData?.extractedToc as string | undefined; // extracted TOC if exists

// Generate table of contents from headings
const headings = (docData?.headings as Array<{ depth: number; slug: string; text: string }>) || [];

// Define page order (Murakami-san feedback: supported-css-features first;
// contribution guides nested under contribution-guide/*)
const pageOrder = [
  'supported-css-features',
  'api',
  'awesome-vivliostyle',
  'contribution-guide',          // hub
  'contribution-guide/js',       // Vivliostyle.js
  'contribution-guide/cli',      // CLI
  'contribution-guide/vfm',      // VFM
  'contribution-guide/themes',   // Themes
];

// Combine all documents available for sidebar/navigation.
// referenceDocs still has the original 'contribution-guide' id (Vivliostyle.js doc); remap for navigation.
const remappedReferenceDocs = referenceDocs.map(d => {
  if (d.id === 'contribution-guide') {
    return { ...d, id: 'contribution-guide/js', data: { ...d.data, title: 'Vivliostyle.js Contribution Guide' } };
  }
  return d;
});
const allDocs = [
  ...remappedReferenceDocs,  // includes awesome-vivliostyle, contribution-guide/js
  { id: 'contribution-guide', data: { title: 'Contribution Guides' } },
  { id: 'contribution-guide/cli', data: { title: 'Vivliostyle CLI Contribution Guide' } },
  { id: 'contribution-guide/vfm', data: { title: 'VFM Contribution Guide' } },
  { id: 'contribution-guide/themes', data: { title: 'Vivliostyle Themes Contribution Guide' } },
];

const sortedDocs = allDocs.sort((a, b) => {
  const indexA = pageOrder.indexOf(a.id);
  const indexB = pageOrder.indexOf(b.id);
  if (indexA === -1 && indexB === -1) return a.id.localeCompare(b.id);
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});

// Get current page index
const currentIndex = sortedDocs.findIndex(d => d.id === doc.id);

// Calculate prevPage/nextPage (only pages in pageOrder)
let prevPage = null;
for (let i = currentIndex - 1; i >= 0; i--) {
  if (pageOrder.includes(sortedDocs[i].id)) {
    prevPage = sortedDocs[i];
    break;
  }
}

let nextPage = null;
for (let i = currentIndex + 1; i < sortedDocs.length; i++) {
  if (pageOrder.includes(sortedDocs[i].id)) {
    nextPage = sortedDocs[i];
    break;
  }
}

// Pages that show in-page H2/H3 navigation in the sidebar (instead of accordion)
const headingListPages = new Set([
  'awesome-vivliostyle',
  'supported-css-features',
  'api',
  'contribution-guide/js',
  'contribution-guide/cli',
  'contribution-guide/vfm',
  'contribution-guide/themes',
]);
const showHeadingList = !isHub && headingListPages.has(doc.id);
---

<DocsLayout
  title={title}
  description={description}
  lang="en"
  section="reference"
  availableLanguages={hasJaTranslation ? ['en', 'ja'] : []}
>
  <!-- Language switcher in header -->
  {hasJaTranslation && (
    <div slot="header">
      <LanguageSwitcher 
        currentLang="en" 
        pagePath={`/reference/${doc.id}`}
        hasTranslation={hasJaTranslation}
      />
    </div>
  )}

  <!-- Sidebar navigation and table of contents -->
  <nav slot="sidebar" id="sidebar-nav">
    <h3><a href="/en/reference/" style="color: inherit; text-decoration: none;">Reference</a></h3>
    
    <!-- Show heading list only for specific pages -->
    {showHeadingList ? (
      <>
        <ul style="list-style: none; padding-left: 0; margin-bottom: 1rem;">
          <li><a href="/en/">← Back to Home</a></li>
        </ul>
        <div class="toc-headings">
          <ul style="list-style: none; padding-left: 0;">
            {headings.filter(h => h.depth === 2 || h.depth === 3).map((heading, index) => {
              // H2見出しのみ処理（H3は後で追加）
              if (heading.depth !== 2) return null;
              
              // 次のH2までのH3を収集
              const nextH2Index = headings.slice(index + 1).findIndex(h => h.depth === 2);
              const h3List = headings
                .slice(index + 1, nextH2Index === -1 ? undefined : index + 1 + nextH2Index)
                .filter(h => h.depth === 3);
              
              // HTMLタグを除去してプレーンテキストのみを取得
              const getPlainText = (html: string) => {
                return html
                  .replace(/<[^>]*>/g, '')
                  .replace(/&amp;|&#x26;/g, '&');
              };
              
              return (
                <li class="toc-h2">
                  {h3List.length > 0 ? (
                    <div class="toc-h2-row">
                      <button
                        class="toc-toggle"
                        data-target={`toc-group-${index}`}
                        aria-expanded="false"
                        aria-controls={`toc-group-${index}`}
                        aria-label={`Toggle ${getPlainText(heading.text)} sub-headings`}
                      >
                        <span class="toggle-icon" aria-hidden="true"></span>
                      </button>
                      <a href={`#${heading.slug}`} class="toc-h2-link">{getPlainText(heading.text)}</a>
                    </div>
                  ) : (
                    <a href={`#${heading.slug}`} class="toc-h2-link">{getPlainText(heading.text)}</a>
                  )}
                  {h3List.length > 0 && (
                    <ul id={`toc-group-${index}`} class="toc-h3-list" style="display: none; list-style: none; padding-left: 1.5rem;">
                      {h3List.map(h3 => (
                        <li class="toc-h3">
                          <a href={`#${h3.slug}`}>{getPlainText(h3.text)}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </>
    ) : (
      <>
        <ul style="list-style: none; padding-left: 0; margin-bottom: 1rem;">
          <li><a href="/en/">← Back to Home</a></li>
        </ul>
        <div class="sidebar-accordion">
          <div class="accordion-section">
            <div class="accordion-header">
              <button class="accordion-toggle" data-target="docs-group" aria-expanded="true" aria-controls="docs-group" aria-label="Toggle Documentation section">
                <span class="toggle-icon" aria-hidden="true"></span>
              </button>
              <span class="accordion-section-title">Documentation</span>
            </div>
            <ul class="accordion-content" id="docs-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
              <li class:list={[{ active: doc.id === 'supported-css-features' }]}>
                <a href="/en/reference/supported-css-features/" aria-current={doc.id === 'supported-css-features' ? 'page' : undefined}>Supported CSS Features</a>
              </li>
              <li class:list={[{ active: doc.id === 'api' }]}>
                <a href="/en/reference/api/" aria-current={doc.id === 'api' ? 'page' : undefined}>Core API Reference</a>
              </li>
              <li class:list={[{ active: doc.id === 'awesome-vivliostyle' }]}>
                <a href="/en/reference/awesome-vivliostyle/" aria-current={doc.id === 'awesome-vivliostyle' ? 'page' : undefined}>Awesome Vivliostyle</a>
              </li>
            </ul>
          </div>
          <div class="accordion-section">
            <div class="accordion-header">
              <button class="accordion-toggle" data-target="contrib-group" aria-expanded="true" aria-controls="contrib-group" aria-label="Toggle Contribution Guides section">
                <span class="toggle-icon" aria-hidden="true"></span>
              </button>
              <a href="/en/reference/contribution-guide/" class="accordion-section-title" aria-current={doc.id === 'contribution-guide' ? 'page' : undefined}>Contribution Guides</a>
            </div>
            <ul class="accordion-content" id="contrib-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
              <li class:list={[{ active: doc.id === 'contribution-guide/js' }]}>
                <a href="/en/reference/contribution-guide/js/" aria-current={doc.id === 'contribution-guide/js' ? 'page' : undefined}>Vivliostyle.js</a>
              </li>
              <li class:list={[{ active: doc.id === 'contribution-guide/cli' }]}>
                <a href="/en/reference/contribution-guide/cli/" aria-current={doc.id === 'contribution-guide/cli' ? 'page' : undefined}>Vivliostyle CLI</a>
              </li>
              <li class:list={[{ active: doc.id === 'contribution-guide/vfm' }]}>
                <a href="/en/reference/contribution-guide/vfm/" aria-current={doc.id === 'contribution-guide/vfm' ? 'page' : undefined}>VFM</a>
              </li>
              <li class:list={[{ active: doc.id === 'contribution-guide/themes' }]}>
                <a href="/en/reference/contribution-guide/themes/" aria-current={doc.id === 'contribution-guide/themes' ? 'page' : undefined}>Vivliostyle Themes</a>
              </li>
            </ul>
          </div>
        </div>
      </>
    )}
    <DownloadLinks product="reference" lang="en" />
  </nav>

  <!-- Main content -->
  <article class="docs-content">

    <!-- Display extracted TOC if exists -->
    {extractedToc && doc.id !== 'awesome-vivliostyle' && (
      <div class="toc">
        {doc.id === 'awesome-vivliostyle' && (
          <h2 class="toc-title">Contents</h2>
        )}
        <div class="toc-body" set:html={extractedToc}></div>
      </div>
    )}
    
    <div set:html={htmlContent}></div>
  </article>

  <!-- Page navigation -->
  <PageNavigation
    prevPage={prevPage}
    nextPage={nextPage}
    basePath="/en/reference"
    prevLabel="← Previous"
    nextLabel="Next →"
  />
</DocsLayout>

<style>
  .docs-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .docs-content h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .toc {
    background: var(--color-background-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .toc-title {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .toc :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .toc :global(li) {
    margin: 0.5rem 0;
  }

  .toc :global(a) {
    color: var(--color-primary);
    text-decoration: none;
  }

  .toc :global(a:hover) {
    text-decoration: underline;
  }
  
  /* Sidebar heading list styles */
  .toc-headings {
    font-size: 0.875rem;
  }
  
  .toc-h2 {
    margin: 0.5rem 0;
  }
  
  .toc-h2-link {
    color: var(--color-text);
    text-decoration: none;
    display: block;
    padding: 0.25rem 0;
  }
  
  .toc-h2-link:hover {
    color: var(--color-primary);
  }
  
  .toc-h2-row {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .toc-toggle {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    padding-top: 0.2rem;
  }

  .toc-toggle:hover {
    color: var(--color-primary);
  }

  .toggle-icon {
    display: inline-block;
    width: 1em;
    font-size: 0.7rem;
  }

  /* Show ▼ when expanded, ▶ when collapsed */
  .toc-toggle .toggle-icon::before,
  .accordion-toggle .toggle-icon::before {
    content: '▶';
  }
  .toc-toggle[aria-expanded="true"] .toggle-icon::before,
  .accordion-toggle[aria-expanded="true"] .toggle-icon::before {
    content: '▼';
  }
  
  .toc-h3-list {
    margin-top: 0.25rem;
  }
  
  .toc-h3 {
    margin: 0.25rem 0;
  }
  
  .toc-h3 a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 1rem;
  }
  
  .toc-h3 a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .docs-content {
      padding: 1rem;
    }

    .docs-content h1 {
      font-size: 2rem;
    }
  }

  /* Accordion menu styles */
  .sidebar-accordion {
    margin-top: 0.5rem;
  }

  .accordion-section {
    margin-bottom: 0.5rem;
  }

  .accordion-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0;
  }

  .accordion-toggle {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
  }

  .accordion-toggle:hover {
    color: var(--color-primary);
  }

  .accordion-section-title {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
  }

  a.accordion-section-title:hover {
    color: var(--color-primary);
  }

  .accordion-content li {
    margin: 0.25rem 0;
  }

  .accordion-content a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
  }

  .accordion-content a:hover {
    color: var(--color-primary);
  }
</style>

<script>
  // Accordion menu and TOC toggle handling
  document.addEventListener('DOMContentLoaded', () => {
    const allToggles = document.querySelectorAll('.accordion-toggle, .toc-toggle');
    allToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const targetId = toggle.getAttribute('data-target');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isExpanded));
        if (targetId) {
          const content = document.getElementById(targetId);
          if (content) content.style.display = isExpanded ? 'none' : 'block';
        }
      });
    });
  });
</script>
