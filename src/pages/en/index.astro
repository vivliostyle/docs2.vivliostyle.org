---
/**
 * 英語版トップページ
 */
import DocsLayout from '../../layouts/DocsLayout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getCollection } from 'astro:content';

// VFMでコンバートされたドキュメントを取得
let indexDoc = null;
let htmlContent = '';

try {
  const docs = await getCollection('docs-en');
  indexDoc = docs.find(doc => doc.id === 'en/index' || doc.id.endsWith('/index') || doc.id === 'index');
  if (indexDoc?.rendered) {
    htmlContent = indexDoc.rendered.html;
  }
} catch (error) {
  console.error('Failed to load docs:', error);
}

const title = indexDoc?.data?.title || 'Welcome to Vivliostyle Documentation';
const description = indexDoc?.data?.description || 'Official documentation for Vivliostyle';
---

<DocsLayout
  title={title}
  description={description}
  lang="en"
  availableLanguages={['en', 'ja']}
>
  <LanguageSwitcher slot="header" currentLang="en" pagePath="/" hasTranslation={true} />
  <nav slot="sidebar" class="home-sidebar">
    <h3>Documentation</h3>
    <ul class="sidebar-top">
      <li class="active"><a href="/en/" aria-current="page">Home</a></li>
    </ul>

    <div class="sidebar-accordion">
      <div class="accordion-section">
        <button class="accordion-toggle" data-target="new-features-group" aria-expanded="true">
          <span class="toggle-icon">▶</span>New Features
        </button>
        <ul class="accordion-content" id="new-features-group">
          <li><a href="/en/new-features/">Overview</a></li>
          <li><a href="/en/new-features/footnotes/">Footnotes</a></li>
          <li><a href="/en/new-features/cmyk/">CMYK Conversion</a></li>
          <li><a href="/en/new-features/page-groups/">Page Groups</a></li>
        </ul>
      </div>

      <div class="accordion-section">
        <button class="accordion-toggle" data-target="product-group" aria-expanded="true">
          <span class="toggle-icon">▶</span>Product
        </button>
        <ul class="accordion-content" id="product-group">
          <li><a href="/en/viewer/">Vivliostyle Viewer</a></li>
          <li><a href="/en/cli/">Vivliostyle CLI</a></li>
          <li><a href="/en/vfm/">VFM</a></li>
          <li><a href="/en/themes/">Vivliostyle Themes</a></li>
        </ul>
      </div>
    </div>

    <ul class="sidebar-flat">
      <li>
        <a href="https://vivliostyle.org/tutorials/" target="_blank" rel="noopener noreferrer">Tutorials</a>
      </li>
    </ul>

    <div class="sidebar-accordion">
      <div class="accordion-section">
        <button class="accordion-toggle" data-target="reference-group" aria-expanded="true">
          <span class="toggle-icon">▶</span>Reference
        </button>
        <div class="accordion-content accordion-content-grouped" id="reference-group">
          <h4 class="subgroup-title">Documentation</h4>
          <ul>
            <li><a href="/en/reference/awesome-vivliostyle/">Awesome Vivliostyle</a></li>
            <li><a href="/en/reference/supported-css-features/">Supported CSS Features</a></li>
            <li><a href="/en/reference/api/">Core API Reference</a></li>
          </ul>
          <h4 class="subgroup-title">Contribution Guides</h4>
          <ul>
            <li><a href="/en/reference/contribution-guide/">Vivliostyle.js</a></li>
            <li><a href="/en/reference/contributing-cli/">Vivliostyle CLI</a></li>
            <li><a href="/en/reference/contributing-vfm/">VFM</a></li>
            <li><a href="/en/reference/contributing-themes/">Vivliostyle Themes</a></li>
          </ul>
        </div>
      </div>
    </div>

    <ul class="sidebar-flat">
      <li>
        <a href="https://vivliostyle.org/faq/" target="_blank" rel="noopener noreferrer">FAQ</a>
      </li>
    </ul>
  </nav>

  {htmlContent ? (
    <Fragment set:html={htmlContent} />
  ) : (
    <article>
      <h1>Welcome to Vivliostyle Documentation</h1>
      <p>Documentation is being loaded...</p>
      <p>If you see this message, the VFM loader may not have processed the content yet.</p>
    </article>
  )}
</DocsLayout>

<style>
  .home-sidebar h3 {
    color: var(--color-text);
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }

  .home-sidebar ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .home-sidebar li {
    margin: 0.25rem 0;
  }

  .home-sidebar a {
    color: var(--color-text);
    text-decoration: none;
  }

  .home-sidebar a:hover {
    color: var(--color-primary);
  }

  .sidebar-top {
    margin-bottom: 0.75rem;
  }

  .sidebar-top li.active a {
    font-weight: bold;
    color: var(--color-primary);
  }

  .sidebar-flat {
    margin: 0.25rem 0 0.5rem;
  }

  .sidebar-accordion {
    margin: 0 0 0.25rem;
  }

  .accordion-section {
    margin-bottom: 0.25rem;
  }

  .accordion-toggle {
    display: flex;
    align-items: center;
    width: 100%;
    background: none;
    border: none;
    padding: 0.25rem 0;
    text-align: left;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .accordion-toggle:hover {
    color: var(--color-primary);
  }

  .toggle-icon {
    display: inline-block;
    transition: transform 0.2s;
    margin-right: 0.5rem;
    font-size: 0.7rem;
  }

  .accordion-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(90deg);
  }

  .accordion-content {
    padding-left: 1.5rem;
    margin: 0.25rem 0 0;
  }

  .accordion-content-grouped > ul {
    margin-bottom: 0.25rem;
  }

  /* L3: 各ナビ項目（アコーディオン配下）。L1 のトグル / トップレベルリンクより一段小さく */
  .accordion-content a {
    font-size: 0.85rem;
    font-weight: 400;
  }

  /* L2: サブグループ見出し。
     - L1 と同じウエイト・muted カラーで「ラベル」として機能
     - margin-left: -0.75rem で accordion-content の padding-left（1.5rem）を半分戻し、
       L3 項目（1.5rem）よりも内側に配置することで親子関係を明示 */
  .subgroup-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin: 0.4rem 0 0.15rem -0.75rem;
    letter-spacing: 0;
  }

  /* 外部リンクには「↗」を末尾に付与し、新しいタブで開くことを示す */
  .home-sidebar a[target="_blank"]::after {
    content: " ↗";
    font-size: 0.85em;
    opacity: 0.7;
    margin-left: 0.15em;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.home-sidebar .accordion-toggle');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = button.getAttribute('data-target');
        const content = targetId ? document.getElementById(targetId) : null;
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        if (content) {
          (content as HTMLElement).style.display = isExpanded ? 'none' : 'block';
        }
      });
    });
  });
</script>
