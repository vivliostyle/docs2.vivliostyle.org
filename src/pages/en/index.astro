---
/**
 * 英語版トップページ
 */
import DocsLayout from '../../layouts/DocsLayout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getCollection } from 'astro:content';

// VFMでコンバートされたドキュメントを取得
let indexDoc = null;
let htmlContent = '';

try {
  const docs = await getCollection('docs-en');
  console.log('docs-en collection:', docs.length, 'documents');
  
  // デバッグ: すべてのドキュメントIDを表示
  docs.forEach(doc => {
    console.log('Doc ID:', doc.id);
  });
  
  indexDoc = docs.find(doc => doc.id === 'en/index' || doc.id.endsWith('/index') || doc.id === 'index');
  
  if (indexDoc) {
    console.log('Found index doc:', indexDoc.id);
    if (indexDoc.rendered) {
      htmlContent = indexDoc.rendered.html;
      console.log('HTML content length:', htmlContent.length);
    }
  }
} catch (error) {
  console.error('Failed to load docs:', error);
}

const title = indexDoc?.data?.title || 'Welcome to Vivliostyle Documentation';
const description = indexDoc?.data?.description || 'Official documentation for Vivliostyle';
---

<DocsLayout
  title={title}
  description={description}
  lang="en"
  availableLanguages={['en', 'ja']}
>
  <LanguageSwitcher slot="header" currentLang="en" pagePath="/" hasTranslation={true} />
  <nav slot="sidebar">
    <h3>Documentation</h3>
    <ul class="top-links" style="list-style: none; padding-left: 0; margin-bottom: 0.5rem;">
      <li><a href="/en/">Home</a></li>
      <li><a href="/en/new-features/">New Features</a></li>
    </ul>
    <div class="sidebar-accordion">
      <div class="accordion-section">
        <div class="accordion-header">
          <button class="accordion-toggle" data-target="products-group" aria-expanded="true" aria-controls="products-group" aria-label="Toggle Products section">
            <span class="toggle-icon" aria-hidden="true"></span>
          </button>
          <span class="accordion-section-title">Products</span>
        </div>
        <ul class="accordion-content" id="products-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
          <li><a href="/en/viewer/">Vivliostyle Viewer</a></li>
          <li><a href="/en/cli/">Vivliostyle CLI</a></li>
          <li><a href="/en/vfm/">VFM</a></li>
          <li><a href="/en/themes/">Vivliostyle Themes</a></li>
        </ul>
      </div>
    </div>
    <ul class="top-links" style="list-style: none; padding-left: 0; margin: 0.5rem 0;">
      <li><a href="https://vivliostyle.org/en/tutorials/" target="_blank" rel="noopener noreferrer">Tutorials</a></li>
    </ul>
    <div class="sidebar-accordion">
      <div class="accordion-section">
        <div class="accordion-header">
          <button class="accordion-toggle" data-target="reference-group" aria-expanded="true" aria-controls="reference-group" aria-label="Toggle Reference section">
            <span class="toggle-icon" aria-hidden="true"></span>
          </button>
          <a href="/en/reference/" class="accordion-section-title">Reference</a>
        </div>
        <ul class="accordion-content" id="reference-group" style="display: block; list-style: none; padding-left: 1.5rem; margin: 0.25rem 0 0 0;">
          <li><a href="/en/reference/supported-css-features/">Supported CSS Features</a></li>
          <li><a href="/en/reference/api/">Core API Reference</a></li>
          <li><a href="/en/reference/awesome-vivliostyle/">Awesome Vivliostyle</a></li>
          <li><a href="/en/reference/contribution-guide/">Contribution Guides</a></li>
        </ul>
      </div>
    </div>
    <ul class="top-links" style="list-style: none; padding-left: 0; margin: 0.5rem 0;">
      <li><a href="https://vivliostyle.org/en/faq/" target="_blank" rel="noopener noreferrer">FAQ</a></li>
    </ul>
  </nav>

  {htmlContent ? (
    <Fragment set:html={htmlContent} />
  ) : (
    <article>
      <h1>Welcome to Vivliostyle Documentation</h1>
      <p>Documentation is being loaded...</p>
      <p>If you see this message, the VFM loader may not have processed the content yet.</p>
    </article>
  )}
</DocsLayout>

<style>
  nav h3 {
    color: var(--color-text);
  }

  nav ul li a {
    color: var(--color-text);
    text-decoration: none;
  }

  nav ul li a:hover {
    color: var(--color-primary);
  }

  .sidebar-accordion {
    margin-top: 0.5rem;
  }

  .accordion-section {
    margin-bottom: 0.5rem;
  }

  .accordion-toggle {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
  }

  .accordion-toggle:hover {
    color: var(--color-primary);
  }

  .toggle-icon {
    display: inline-block;
    width: 1em;
    font-size: 0.7rem;
  }

  /* Show ▼ when expanded, ▶ when collapsed via ::before content swap.
   * Rotation-based approaches don't always render visually as ▼ across
   * environments, so swap the actual character. */
  .accordion-toggle .toggle-icon::before {
    content: '▶';
  }
  .accordion-toggle[aria-expanded="true"] .toggle-icon::before {
    content: '▼';
  }

  .accordion-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .accordion-section-title {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
  }

  a.accordion-section-title:hover {
    color: var(--color-primary);
  }

  .accordion-content li {
    margin: 0.25rem 0;
  }

  .accordion-content a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
  }

  .accordion-content a:hover {
    color: var(--color-primary);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.accordion-toggle');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-target');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        if (targetId) {
          const content = document.getElementById(targetId);
          if (content) content.style.display = isExpanded ? 'none' : 'block';
        }
      });
    });
  });
</script>
