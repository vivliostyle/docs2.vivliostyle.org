---
/**
 * Vivliostyle Viewer リンクコンポーネント
 *
 * Web/PDF/EPUB と同じ Markdown ソースを、Vivliostyle Viewer で
 * ライブ組版して表示するリンク。新規タブで開く。
 */
interface Props {
  product: 'cli' | 'vfm' | 'themes' | 'viewer' | 'reference' | 'cookbook';
  lang: 'en' | 'ja';
}

const { product, lang } = Astro.props;

const label = lang === 'ja'
  ? 'Vivliostyle Viewer で開く ↗'
  : 'Open in Vivliostyle Viewer ↗';

const manifestUrl = `https://docs.vivliostyle.org/publications/${product}-${lang}/publication.json`;
const viewerUrl = `https://vivliostyle.org/viewer/#src=${manifestUrl}&bookMode=true&lng=${lang}`;
---

<a
  href={viewerUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="liveview-link"
>
  <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .liveview-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    margin-top: 0.5rem;
    border: 1px solid var(--color-primary);
    border-radius: 4px;
    background: transparent;
    color: var(--color-primary);
    font-size: 0.9rem;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
    width: 100%;
    text-align: left;
  }

  .liveview-link:hover {
    background-color: var(--color-primary);
    color: #fff;
  }

  .liveview-link svg {
    flex-shrink: 0;
  }
</style>
