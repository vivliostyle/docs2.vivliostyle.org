---
/**
 * 現在ページの H2/H3 をサイドバーに展開するコンポーネント。
 *
 * - H3 を持つ H2: H2 リンクの横に折りたたみトグルボタンを置く（既定: 閉）
 * - H3 を持たない H2: 単純なリンク
 * - <button> と <a> をネストしないため HTML 上正当
 * - トグルは `aria-controls` で対象を参照し、`hidden` 属性の付与/除去で
 *   開閉状態を DOM 上にも反映する
 *
 * 各ページの sidebar 内、現在ページの <li> の中に置く想定。
 * 同一ページ内の他のトグル要素とぶつからないよう `idPrefix` を変えられる。
 */

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  idPrefix?: string;
  lang?: 'en' | 'ja';
}

const { headings = [], idPrefix = 'toc-group', lang = 'en' } = Astro.props;

const filtered = headings.filter((h) => h && h.slug && (h.depth === 2 || h.depth === 3));

function getPlainText(html: string): string {
  return html.replace(/<[^>]*>/g, '').replace(/&amp;|&#x26;/g, '&');
}

function toggleAriaLabel(headingText: string): string {
  return lang === 'ja'
    ? `${headingText} のサブセクションを開閉`
    : `Toggle subsections of ${headingText}`;
}
---

{filtered.length > 0 && (
  <ul class="toc-headings">
    {filtered.map((heading, index, arr) => {
      if (heading.depth !== 2) return null;

      const nextH2RelativeIndex = arr.slice(index + 1).findIndex((h) => h.depth === 2);
      const h3List = arr
        .slice(index + 1, nextH2RelativeIndex === -1 ? undefined : index + 1 + nextH2RelativeIndex)
        .filter((h) => h.depth === 3);

      const plainText = getPlainText(heading.text);
      const groupId = `${idPrefix}-${index}`;

      return (
        <li class="toc-h2">
          <div class="toc-h2-row">
            <a href={`#${heading.slug}`} class="toc-h2-link">{plainText}</a>
            {h3List.length > 0 && (
              <button
                class="toc-toggle"
                type="button"
                aria-controls={groupId}
                aria-expanded="false"
                aria-label={toggleAriaLabel(plainText)}
              >
                <span class="toggle-icon" aria-hidden="true">▶</span>
              </button>
            )}
          </div>
          {h3List.length > 0 && (
            <ul id={groupId} class="toc-h3-list" hidden>
              {h3List.map((h3) => (
                <li class="toc-h3">
                  <a href={`#${h3.slug}`}>{getPlainText(h3.text)}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })}
  </ul>
)}

<style>
  .toc-headings {
    list-style: none;
    padding-left: 0.75rem;
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
  }

  .toc-h2 {
    margin: 0.25rem 0;
  }

  .toc-h2-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .toc-h2-link {
    color: var(--color-text);
    text-decoration: none;
    display: block;
    padding: 0.2rem 0;
    flex: 1;
  }

  .toc-h2-link:hover {
    color: var(--color-primary);
  }

  /* <button> の UA 既定スタイルを完全に剥がす（ナイトモードでの背景色潰れ対策）*/
  .toc-toggle {
    display: inline-flex;
    align-items: center;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
    padding: 0.2rem 0.25rem;
    margin: 0;
    cursor: pointer;
    color: var(--color-text);
    font: inherit;
    flex: 0 0 auto;
  }

  .toc-toggle:hover {
    color: var(--color-primary);
  }

  .toc-toggle .toggle-icon {
    display: inline-block;
    transition: transform 0.2s;
    font-size: 0.7rem;
  }

  .toc-toggle[aria-expanded="true"] .toggle-icon {
    transform: rotate(90deg);
  }

  .toc-h3-list {
    list-style: none;
    padding-left: 1.5rem;
    margin: 0.25rem 0 0;
  }

  /* `hidden` 属性は UA で `display: none` だが flex/grid 親などで打ち消されないよう明示 */
  .toc-h3-list[hidden] {
    display: none;
  }

  .toc-h3 {
    margin: 0.2rem 0;
  }

  .toc-h3 a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .toc-h3 a:hover {
    color: var(--color-primary);
  }
</style>

<script>
  // 同じページ内に複数のサイドバーがあっても全 toc-toggle に効くよう document スコープで聴取
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.toc-toggle');
    toggleButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('aria-controls');
        if (!targetId) return;
        const targetList = document.getElementById(targetId);
        if (!targetList) return;
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isExpanded));
        if (isExpanded) {
          targetList.setAttribute('hidden', '');
        } else {
          targetList.removeAttribute('hidden');
        }
      });
    });
  });
</script>
