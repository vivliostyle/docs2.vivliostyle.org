---
/**
 * ダウンロードリンクコンポーネント
 * 各プロダクトのドキュメントPDF/EPUBへのダウンロードリンクを表示
 */
import LiveView from './LiveView.astro';

interface Props {
  product: 'cli' | 'vfm' | 'themes' | 'viewer' | 'reference' | 'cookbook';
  lang: 'en' | 'ja';
}

const { product, lang } = Astro.props;

const fileBase: Record<Props['product'], string> = {
  cli: 'vivliostyle-cli',
  vfm: 'vfm',
  themes: 'vivliostyle-themes',
  viewer: 'vivliostyle-viewer',
  reference: 'vivliostyle-reference',
  cookbook: 'vivliostyle-cookbook',
};

const pdfHref = `/downloads/${fileBase[product]}-${lang}.pdf`;
const epubHref = `/downloads/${fileBase[product]}-${lang}.epub`;

const labels = lang === 'ja'
  ? { heading: 'Vivliostyle CLI生成物のダウンロード', pdf: 'PDF版', epub: 'EPUB版' }
  : { heading: 'Downloads (built by Vivliostyle CLI)', pdf: 'PDF', epub: 'EPUB' };
---

<section class="downloads" aria-label={labels.heading}>
  <h3 class="downloads-heading">{labels.heading}</h3>
  <ul class="downloads-list">
    <li>
      <a href={pdfHref} download class="download-link">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{labels.pdf}</span>
      </a>
    </li>
    <li>
      <a href={epubHref} download class="download-link">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{labels.epub}</span>
      </a>
    </li>
  </ul>
  <LiveView product={product} lang={lang} />
</section>

<style>
  .downloads {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .downloads-heading {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }

  .downloads-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.9rem;
    transition: background-color 0.2s, color 0.2s;
  }

  .download-link:hover {
    background-color: var(--color-bg-secondary);
    color: var(--color-primary);
  }

  .download-link svg {
    flex-shrink: 0;
    color: var(--color-primary);
  }
</style>
